# Lead Hunter Agents — Environment Variables
# Copy this to .env and fill in your keys

# Google Places API key (optional — enables highest quality lead data)
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# Google Maps API key (for website builder)
GOOGLE_MAPS_API_KEY=

# Anthropic Claude API key (for AI-powered enrichment and reasoning)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Formspree form ID (for website contact forms)
FORMSPREE_FORM_ID=

# Supabase (for lead storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email outreach)
RESEND_API_KEY=
FROM_EMAIL=info@synker.co
FROM_NAME=PODIUM AI WEBSITE AGENCY

# Twilio (SMS outreach)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Business info (used in outreach messages)
YOUR_COMPANY_NAME=WebPros
YOUR_WEBSITE=https://webpros.com
YOUR_CALENDLY=

# Stripe (payment links in follow-up emails)
STRIPE_PAYMENT_LINK=
